{
  "name": "@sitechat/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "crawl": "tsx src/cli/crawl.ts",
    "eval": "tsx src/cli/eval.ts",
    "test": "vitest run",
    "index-site": "tsx src/cli/index-site.ts",
    "dump": "tsx src/cli/dump.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "jsdom": "^26.1.0",
    "nanoid": "^5.1.5",
    "robots-parser": "^3.0.1",
    "tldts": "^7.0.0",
    "undici": "^7.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
