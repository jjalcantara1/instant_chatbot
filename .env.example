PORT=8080
DATABASE_PATH=./data/sitechat.db

# Chat. CHAT_PROVIDER=anthropic (default) or gemini; CHAT_MODEL is
# provider-specific and falls back to that provider's default if it does not match.
CHAT_PROVIDER=anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Only needed for an identity-linked API key, which rejects every request
# without it ("anthropic-workspace-id is required"). Leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=
# Pinned snapshot ID for Claude Haiku 4.5. Alias `claude-haiku-4-5` also resolves.
CHAT_MODEL=claude-haiku-4-5-20251001

# Embeddings (OpenAI). Swap EMBEDDING_PROVIDER=voyage to use voyage-3-lite.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=

# Secrets
IP_HASH_SALT=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too

# Retrieval floor. Defaults per embedding model (voyage 0.35, openai 0.25);
# set only to override. This is the guard against answering off-site questions.
MIN_COSINE=

# Embedding throughput. Defaults suit a paid provider tier. A free/low-quota
# key needs e.g. 32 / 1 / 21000, which completes but blows the time budget.
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CONCURRENCY=4
EMBEDDING_MIN_INTERVAL_MS=0

# Limits
MAX_PAGES=25
CRAWL_TIMEOUT_MS=45000
DAILY_INDEX_CAP=200
CONCURRENT_CRAWLS=3
INDEX_PER_IP_PER_HOUR=3
MESSAGES_PER_IP_PER_HOUR=60
MAX_MESSAGES_PER_SESSION=20

PUBLIC_WIDGET_ORIGIN=https://sitechat.kleio-software.dev
