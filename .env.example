PORT=8080
DATABASE_PATH=./data/sitechat.db

# Chat. CHAT_PROVIDER=anthropic (default) or gemini; CHAT_MODEL is
# provider-specific and falls back to that provider's default if it does not match.
CHAT_PROVIDER=anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Only needed for an identity-linked API key, which rejects every request
# without it ("anthropic-workspace-id is required"). Leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=
# Pinned snapshot ID for Claude Haiku 4.5. Alias `claude-haiku-4-5` also resolves.
CHAT_MODEL=claude-haiku-4-5-20251001

# Embeddings (OpenAI). Swap EMBEDDING_PROVIDER=voyage to use voyage-3-lite,
# or EMBEDDING_PROVIDER=local to run bge-small-en-v1.5 inside the server: no
# key and no quota; the model downloads once (34 MB) into EMBEDDING_CACHE_DIR,
# which defaults to a models/ folder next to the database.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
EMBEDDING_CACHE_DIR=

# Secrets
IP_HASH_SALT=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too

# Retrieval floor. Defaults per embedding model (local 0.45, voyage 0.25, openai 0.25);
# set only to override. Below it a question is refused without calling the
# model; above it the model decides, and must cite or refuse. Run both eval
# fixtures (`npm run eval`) before changing it.
MIN_COSINE=

# Start a second chat request if the first has sent nothing back after this
# many ms, and use whichever answers first. 0 disables.
CHAT_HEDGE_MS=4000

# Embedding throughput. Defaults suit a paid provider tier. A free/low-quota
# key needs e.g. 32 / 1 / 21000, which completes but blows the time budget.
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CONCURRENCY=4
EMBEDDING_MIN_INTERVAL_MS=0

# Limits
# DEFAULT_PAGES is what a visitor gets without asking for more: 1 means the
# landing page and nothing else, which skips sitemap discovery entirely and
# indexes in a couple of seconds. MAX_PAGES is the ceiling they may opt into,
# in one pass or by expanding the session afterwards. EXPAND_STEP is how many
# pages one "read more" adds.
DEFAULT_PAGES=1
MAX_PAGES=25
EXPAND_STEP=5
# Budget for a FULL MAX_PAGES crawl. Shorter crawls scale down from it, so a
# one-page run is not held for the whole window by a site that hangs.
CRAWL_TIMEOUT_MS=45000
DAILY_INDEX_CAP=200
CONCURRENT_CRAWLS=3
INDEX_PER_IP_PER_HOUR=3
# Expansions are limited separately from indexes: with a one-page default this
# is the normal way to get a bigger index, so it must not eat the index budget.
EXPANDS_PER_IP_PER_HOUR=10
MESSAGES_PER_IP_PER_HOUR=60
MAX_MESSAGES_PER_SESSION=20

PUBLIC_WIDGET_ORIGIN=https://sitechat.kleiosoftware.com
