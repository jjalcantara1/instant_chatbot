# /etc/systemd/system/sitechat.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now sitechat
[Unit]
Description=Instant Site Chat API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sitechat
Group=sitechat
WorkingDirectory=/srv/sitechat/server
EnvironmentFile=/srv/sitechat/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3

# The process fetches URLs supplied by strangers. Give it as little as possible.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
# NOTE: no MemoryDenyWriteExecute= here either. V8 is a JIT -- it maps pages
# writable and then executable to emit machine code, which is exactly what
# that setting forbids. With it on, node dies at startup with SIGTRAP and
# systemd reports `code=killed, signal=TRAP` with no other explanation.
# The SQLite file and its WAL are the only things it may write.
ReadWritePaths=/srv/sitechat/data

# NOTE: there is deliberately no IPAddressDeny= here.
#
# systemd's IP filter is not direction-aware, so `IPAddressDeny=localhost`
# blocks Caddy's reverse_proxy into :8080 just as surely as it blocks the
# crawler dialling out to loopback -- the service comes up and then 502s.
# `IPAddressDeny=link-local` is worse on GCE specifically: the resolver is
# either the metadata server on 169.254.169.254 or a systemd-resolved stub on
# 127.0.0.53, so one of those two rules kills DNS and no crawl resolves at all.
#
# The real control is server/src/crawl/ssrf.ts, which is direction-aware in the
# way systemd cannot be: it blocks 127.0.0.0/8, ::1 and 169.254.0.0/16 for
# crawl targets only, re-runs on every redirect hop, and pins the connection to
# the exact addresses it vetted so DNS cannot be rebound underneath it. 51 tests
# cover it. Do not "harden" this by adding the rules back.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sitechat

[Install]
WantedBy=multi-user.target
