# Copy to /srv/sitechat/.env on the VM, fill in the keys, then:
#   sudo chown root:sitechat /srv/sitechat/.env && sudo chmod 640 /srv/sitechat/.env
#
# This file is read twice: by systemd (EnvironmentFile=) and by dotenv, which
# never overrides an already-set variable, so systemd wins. Keep it to plain
# KEY=value -- systemd does not evaluate shell syntax, so no $VAR, no backticks,
# and no unquoted '#' inside a value.

PORT=8080
# Absolute on purpose. The relative default resolves against the detected
# project root, which happens to land in the right place, but pinning it here
# means it cannot drift away from the systemd ReadWritePaths= grant.
DATABASE_PATH=/srv/sitechat/data/sitechat.db

# --- Chat -------------------------------------------------------------------
# Matches the local .env: Gemini for chat, Voyage for embeddings.
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Only for an identity-linked Anthropic key. Leave blank on Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# --- Embeddings -------------------------------------------------------------
# local: bge-small-en-v1.5 runs inside the server. No key, no quota, and no
# network round trip per question. On the eval it retrieved as well as
# voyage-3-lite (the answering chunk in the top six for 42/42 questions). It
# costs ~80 MB of memory for the model plus up to ~100 MB while embedding a
# large site, and downloads once (34 MB) into EMBEDDING_CACHE_DIR, which
# defaults to data/models -- the one directory the systemd unit can write.
# English only: a site in another language retrieves worse than on Voyage.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
#
# The Voyage alternative, if a card is ever put on file (the 200M free tokens
# still apply; unbilled, it is capped at 3 requests a minute -- see below):
#   EMBEDDING_PROVIDER=voyage
#   EMBEDDING_MODEL=voyage-3-lite
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Leave blank to take the per-provider default (local 0.45, voyage 0.25).
# Questions with nothing above this floor are refused without calling the
# model; everything else is decided by the model, which must answer with a
# citation or not at all. Both fixtures of `npm run eval` must pass before
# changing it -- or changing EMBEDDING_PROVIDER, whose floors differ.
MIN_COSINE=

# A second chat request starts if the first has sent nothing back after this
# many milliseconds, and whichever answers first is used. About one Gemini
# call in twenty hangs until the 30-second timeout otherwise. 0 disables.
CHAT_HEDGE_MS=4000

# --- Secrets ----------------------------------------------------------------
# Generate fresh values on the VM, do not reuse the dev ones:
#   openssl rand -hex 32
IP_HASH_SALT=
ADMIN_TOKEN=

# --- Throughput -------------------------------------------------------------
# For the local embedder: no pacing (there is no provider to pace for), and
# one batch at a time, since the model runs on a single thread anyway.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=1
EMBEDDING_MIN_INTERVAL_MS=0
#
# For an UNBILLED Voyage key instead, which is capped at 3 requests per minute
# and 10,000 tokens per minute: 16 chunks per request every 21s is ~2.9 RPM and
# ~9.6k TPM -- just inside both. Batches of 32 fit the request limit but blow
# the token limit, and the index fails with RATE_LIMITED partway through. The
# cost is speed: every embedding request, including the one each question
# needs, waits for a 21-second slot shared by all visitors.
#   EMBEDDING_BATCH_SIZE=16
#   EMBEDDING_CONCURRENCY=1
#   EMBEDDING_MIN_INTERVAL_MS=21000
# A billed Voyage key: 100 / 4 / 0.

# --- Limits -----------------------------------------------------------------
# What a visitor gets without asking for more. 1 is the landing page alone: one
# fetch, no sitemap round trips, one embedding batch -- a couple of seconds end
# to end. This matters more on the free-tier box than anywhere else, because a
# short crawl is also the one that does not exhaust its memory.
DEFAULT_PAGES=1
# The ceiling a visitor may opt into, whether in one pass or by expanding the
# session afterwards a few pages at a time.
MAX_PAGES=25
EXPAND_STEP=5
# Budget for a FULL MAX_PAGES crawl. Shorter crawls scale down from it.
CRAWL_TIMEOUT_MS=45000
DAILY_INDEX_CAP=200
# Each crawl holds up to 6 fetched pages at once (each capped at 2 MB) and
# parses them one at a time with cheerio.
#
# Set to 2 for the free-tier e2-micro this is deployed on. That figure was
# sized when pages were parsed through jsdom, which was far heavier and is now
# gone; re-measure memory under load before raising it. If crawls still die
# partway through on larger sites, drop this to 1 -- queued visitors wait
# rather than failing. On a 2 GB e2-small, 3 is fine.
CONCURRENT_CRAWLS=2
INDEX_PER_IP_PER_HOUR=3
# Expansions are limited separately: with a one-page default, reading more is
# the normal path, so it must not spend the index budget.
EXPANDS_PER_IP_PER_HOUR=10
MESSAGES_PER_IP_PER_HOUR=60
MAX_MESSAGES_PER_SESSION=20

# Where widget.js is actually served from -- the embed snippet is built from
# this string, so it must be this API's own public origin.
PUBLIC_WIDGET_ORIGIN=https://sitechat.kleiosoftware.com
