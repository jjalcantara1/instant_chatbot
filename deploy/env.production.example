# Copy to /srv/sitechat/.env on the VM, fill in the keys, then:
#   sudo chown root:sitechat /srv/sitechat/.env && sudo chmod 640 /srv/sitechat/.env
#
# This file is read twice: by systemd (EnvironmentFile=) and by dotenv, which
# never overrides an already-set variable, so systemd wins. Keep it to plain
# KEY=value -- systemd does not evaluate shell syntax, so no $VAR, no backticks,
# and no unquoted '#' inside a value.

PORT=8080
# Absolute on purpose. The relative default resolves against the detected
# project root, which happens to land in the right place, but pinning it here
# means it cannot drift away from the systemd ReadWritePaths= grant.
DATABASE_PATH=/srv/sitechat/data/sitechat.db

# --- Chat -------------------------------------------------------------------
# Matches the local .env: Gemini for chat, Voyage for embeddings.
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Only for an identity-linked Anthropic key. Leave blank on Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# --- Embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-lite
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Leave blank to take the per-provider default (voyage 0.35). This floor is the
# "not on this site" guarantee; re-run `npm run eval` before changing it.
MIN_COSINE=

# --- Secrets ----------------------------------------------------------------
# Generate fresh values on the VM, do not reuse the dev ones:
#   openssl rand -hex 32
IP_HASH_SALT=
ADMIN_TOKEN=

# --- Throughput -------------------------------------------------------------
# These are sized for an UNBILLED Voyage key, which is capped at 3 requests per
# minute and 10,000 tokens per minute. Chunks target 800 characters (~200
# tokens), so 16 per request every 21s is ~2.9 RPM and ~9.6k TPM -- just inside
# both. Batches of 32 fit the request limit but blow the token limit and the
# whole index fails with RATE_LIMITED partway through.
#
# The cost of this is speed: a 17-page site is ~245 chunks, which is 16 requests
# and takes about five minutes rather than the under-a-minute the demo promises.
#
# ADDING A PAYMENT METHOD AT dashboard.voyageai.com LIFTS THIS AND IS FREE --
# Voyage still grants 200M free tokens for the series-3 models with a card on
# file. Once standard limits apply, set these back to 100 / 4 / 0.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CONCURRENCY=1
EMBEDDING_MIN_INTERVAL_MS=21000

# --- Limits -----------------------------------------------------------------
# What a visitor gets without asking for more. 1 is the landing page alone: one
# fetch, no sitemap round trips, one embedding batch -- a couple of seconds end
# to end. This matters more on the free-tier box than anywhere else, because a
# short crawl is also the one that does not exhaust its memory.
DEFAULT_PAGES=1
# The ceiling a visitor may opt into, whether in one pass or by expanding the
# session afterwards a few pages at a time.
MAX_PAGES=25
EXPAND_STEP=5
# Budget for a FULL MAX_PAGES crawl. Shorter crawls scale down from it.
CRAWL_TIMEOUT_MS=45000
DAILY_INDEX_CAP=200
# Memory, not CPU, is the ceiling here: each crawl parses up to 6 pages at once
# through jsdom, so this is really "N x 6 concurrent jsdom documents".
#
# Set to 2 for the free-tier e2-micro this is deployed on: 1 GB of RAM plus 2 GB
# of swap survives ~12 documents in flight, but not the 18 that 3 would allow.
# If crawls still die partway through on larger sites, drop this to 1 -- queued
# visitors wait rather than failing. On a 2 GB e2-small, 3 is fine.
CONCURRENT_CRAWLS=2
INDEX_PER_IP_PER_HOUR=3
# Expansions are limited separately: with a one-page default, reading more is
# the normal path, so it must not spend the index budget.
EXPANDS_PER_IP_PER_HOUR=10
MESSAGES_PER_IP_PER_HOUR=60
MAX_MESSAGES_PER_SESSION=20

# Where widget.js is actually served from -- the embed snippet is built from
# this string, so it must be this API's own public origin.
PUBLIC_WIDGET_ORIGIN=https://sitechat.kleiosoftware.com
