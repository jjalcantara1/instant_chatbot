# Caddy terminates TLS, serves the demo page off disk, and forwards everything
# the Node process owns to localhost:8080.
#
# Single origin on purpose. web/src/api.ts calls relative paths (/api/sessions,
# /api/sessions/:id/events), which only resolve if the page and the API share a
# hostname. Splitting them across two hosts needs an API base URL in the client
# plus CORS on the SSE route -- see deploy/README.md.
sitechat.kleiosoftware.com {
	# SSE must not be buffered; the live crawl log is the product. Compression
	# buffers too, so the stream routes are excluded from `encode` as well as
	# given flush_interval -1.
	@sse path /api/sessions/*/events /api/sessions/*/messages
	@buffered not path /api/sessions/*/events /api/sessions/*/messages
	@assets path /assets/*
	@html path / /index.html

	encode @buffered gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle @sse {
		reverse_proxy localhost:8080 {
			flush_interval -1
		}
	}

	# Routes owned by Node. widget.js stays on Node rather than being served off
	# disk because that handler sets Access-Control-Allow-Origin: * -- the widget
	# is embedded on other people's sites.
	handle /api/* {
		reverse_proxy localhost:8080
	}
	handle /healthz {
		reverse_proxy localhost:8080
	}
	handle /widget.js {
		reverse_proxy localhost:8080
	}

	# The React demo page. Vite fingerprints everything under /assets, so those
	# are immutable; index.html must never be cached or a deploy goes unseen.
	handle {
		root * /srv/sitechat/web
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/sitechat.log
		format json
	}
}
